# SwasthAI Environment Variables
# Copy this file to .env and update values for your environment

# Database
POSTGRES_PASSWORD=swasthai_secret_password

# Flask
SECRET_KEY=change-this-to-a-long-random-string-in-production
FLASK_ENV=development

# Optional: Custom port
# FLASK_PORT=5000

# Optional: public URL used by setup scripts when printing login links
APP_BASE_URL=https://swasthai-2tv5.onrender.com
DEMO_BASE_URL=https://swasthai-2tv5.onrender.com

# Twilio Configuration for OTP SMS
# Sign up at https://www.twilio.com/try-twilio
# Get your credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
